# IDE / editor
.idea/
.vs/
.vscode/
*.user

# CMake local overrides (user-specific, shouldn't be shared)
CMakeUserPresets.json

# Build output
build/
cmake-build*/

# Tool caches
.cache/
.xwin-cache/

# Packaging output. Inherited from the CommonLibSSE-NG template, which ships a
# scripts/pack.ps1 this repo has never had — kept because a hand-made pack/ or
# dist/ still must not be committed.
pack/
dist/

# OS junk
.DS_Store
Thumbs.db

# Build logs (this project builds straight from the CLI, not an IDE)
*.log

# Python bytecode
__pycache__/
*.pyc
